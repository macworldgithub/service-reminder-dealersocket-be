PORT=7000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (e.g., https://your-dealersocket-fe.vercel.app)
FRONTEND_URL=https://service-reminder-dealersocket-fe.vercel.app

# Upload Configuration
UPLOAD_MAX_SIZE=25000000
UPLOAD_DIR=uploads
